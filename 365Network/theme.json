{
  "name": "365Network",
  "slug": "365network",
  "version": "3.0.0",
  "author": "PHINIT.DE / Andreas Hepp",
  "description": "IT-Networking-Dashboard – Deep Navy & Gold, modulares Kachel-Layout für Experten, Firmen, Events & Speaker.",
  "tags": ["professional", "editorial", "responsive", "cms", "network", "dark-mode"],
  "supports": ["dark-mode", "custom-logo", "sticky-header", "custom-css", "network-animation"],

  "customization": {

    "colors": {
      "label": "Farben",
      "description": "Globale Farbpalette – Deep Navy & Gold. Core-Farben + theme-spezifische Erweiterungen.",
      "settings": {
        "primary_color": {
          "label": "Primärfarbe (Deep Navy)",
          "type": "color",
          "default": "#0c1526",
          "description": "Hauptfarbe – Header, Footer, dunkle UI-Elemente"
        },
        "primary_hover": {
          "label": "Primärfarbe (Hover)",
          "type": "color",
          "default": "#162040",
          "description": "Hover-Zustand der Primärfarbe – dunklere Navy-Variante"
        },
        "primary_light": {
          "label": "Primärfarbe (Hell)",
          "type": "color",
          "default": "#1a2a42",
          "description": "Helle Variante – Badge-Hintergründe, Borders auf dunklem Grund"
        },
        "secondary_color": {
          "label": "Sekundärfarbe (Grau)",
          "type": "color",
          "default": "#64748b",
          "description": "Graue UI-Farbe – Meta-Texte, Labels, sekundäre Informationen"
        },
        "accent_color": {
          "label": "Akzentfarbe (Gold)",
          "type": "color",
          "default": "#c8952e",
          "description": "Gold-Akzent – CTAs, Tags, Highlights, Navigation"
        },
        "accent_hover": {
          "label": "Akzentfarbe (Hover)",
          "type": "color",
          "default": "#a67a24",
          "description": "Dunklere Gold-Variante für Hover-Zustände"
        },
        "accent_light": {
          "label": "Akzentfarbe (Hell)",
          "type": "color",
          "default": "#d4a84a",
          "description": "Hellere Gold-Variante für dezente Highlights"
        },
        "text_color": {
          "label": "Textfarbe",
          "type": "color",
          "default": "#1e293b",
          "description": "Hauptfarbe für Fließtext und Body-Content"
        },
        "heading_color": {
          "label": "Überschriftenfarbe",
          "type": "color",
          "default": "#0f172a",
          "description": "Farbe aller Überschriften (h1–h6)"
        },
        "text_light": {
          "label": "Helle Textfarbe",
          "type": "color",
          "default": "#e2e8f0",
          "description": "Helle Textfarbe – für dunkle Hintergründe (Header, Footer, Hero)"
        },
        "bg_color": {
          "label": "Seitenhintergrund",
          "type": "color",
          "default": "#f8fafc",
          "description": "Hintergrundfarbe des Content-Bereichs"
        },
        "bg_secondary": {
          "label": "Sekundärer Hintergrund",
          "type": "color",
          "default": "#f1f5f9",
          "description": "Hintergrund für Body, Cards, Sidebar-Bereiche"
        },
        "link_color": {
          "label": "Linkfarbe",
          "type": "color",
          "default": "#c8952e",
          "description": "Standard-Linkfarbe im Content-Bereich"
        },
        "link_hover_color": {
          "label": "Link Hover-Farbe",
          "type": "color",
          "default": "#a67a24",
          "description": "Linkfarbe beim Hover-Zustand"
        },
        "muted_color": {
          "label": "Gedämpfte Textfarbe",
          "type": "color",
          "default": "#94a3b8",
          "description": "Sehr dezenter Text – Timestamps, Platzhalter, Hints"
        },
        "border_color": {
          "label": "Rahmenfarbe",
          "type": "color",
          "default": "#e2e8f0",
          "description": "Standard-Rahmenfarbe für Trennlinien, Cards und Inputs"
        },
        "success_color": {
          "label": "Erfolgsfarbe",
          "type": "color",
          "default": "#22c55e",
          "description": "Positivmeldungen und Status-Badges (Grün)"
        },
        "error_color": {
          "label": "Fehlerfarbe",
          "type": "color",
          "default": "#ef4444",
          "description": "Fehlermeldungen und Warnungen (Rot)"
        }
      }
    },

    "typography": {
      "label": "Typografie",
      "description": "Schriftarten, -größen und Zeilenhöhe für Text und Überschriften.",
      "settings": {
        "font_family_base": {
          "label": "Basis-Schriftart",
          "type": "select",
          "options": {
            "system": "System-Standard",
            "inter": "Inter",
            "roboto": "Roboto",
            "open-sans": "Open Sans",
            "lato": "Lato",
            "montserrat": "Montserrat",
            "poppins": "Poppins",
            "raleway": "Raleway"
          },
          "default": "system",
          "description": "Schriftart für Fließtext – System-Standard für optimale Performance"
        },
        "font_family_heading": {
          "label": "Überschriften-Schriftart",
          "type": "select",
          "options": {
            "system": "System-Standard",
            "georgia": "Georgia (Serif)",
            "inter": "Inter",
            "roboto": "Roboto",
            "open-sans": "Open Sans",
            "lato": "Lato",
            "montserrat": "Montserrat",
            "poppins": "Poppins",
            "raleway": "Raleway"
          },
          "default": "system",
          "description": "Schriftart für Überschriften (sans-serif passend zum Dashboard-Design)"
        },
        "font_size_base": {
          "label": "Basis-Schriftgröße (px)",
          "type": "number",
          "default": 16,
          "min": 12,
          "max": 24,
          "description": "Schriftgröße des Fließtexts in Pixeln"
        },
        "line_height_base": {
          "label": "Zeilenhöhe",
          "type": "number",
          "default": 1.6,
          "min": 1.2,
          "max": 2.5,
          "step": 0.1,
          "description": "Zeilenhöhe des Fließtexts (Faktor)"
        },
        "font_weight_heading": {
          "label": "Überschriften-Gewicht",
          "type": "select",
          "options": {
            "400": "Regular (400)",
            "500": "Medium (500)",
            "600": "Semi-Bold (600)",
            "700": "Bold (700)",
            "800": "Extra-Bold (800)",
            "900": "Black (900)"
          },
          "default": "700",
          "description": "Font-Weight für alle Überschriften"
        }
      }
    },

    "layout": {
      "label": "Layout",
      "description": "Containerbreite, Abstände, Eckenradius und strukturelle Layout-Optionen.",
      "settings": {
        "container_width": {
          "label": "Container-Breite (px)",
          "type": "number",
          "default": 1400,
          "min": 800,
          "max": 1920,
          "description": "Maximale Breite des Inhaltsbereichs in Pixeln"
        },
        "content_padding": {
          "label": "Content-Padding (rem)",
          "type": "number",
          "default": 2,
          "min": 0.5,
          "max": 6,
          "step": 0.25,
          "description": "Horizontaler Innenabstand des Containers"
        },
        "border_radius": {
          "label": "Eckenradius (px)",
          "type": "number",
          "default": 8,
          "min": 0,
          "max": 32,
          "description": "Standard-Rundung für Cards, Buttons und Felder"
        },
        "section_spacing": {
          "label": "Sektionsabstand (rem)",
          "type": "number",
          "default": 4,
          "min": 1,
          "max": 12,
          "step": 0.5,
          "description": "Vertikaler Abstand zwischen Seitenbereichen"
        },
        "enable_sticky_header": {
          "label": "Sticky Header aktivieren",
          "type": "checkbox",
          "default": true,
          "description": "Header bleibt beim Scrollen oben fixiert"
        }
      }
    },

    "header": {
      "label": "Header & Logo",
      "description": "Farben, Höhe, Verhalten und Funktionen der Navigationsleiste.",
      "settings": {
        "logo_url": {
          "label": "Header Logo",
          "type": "image",
          "default": "",
          "description": "Logo-Bild im Header (JPG, PNG, WebP, SVG – max. 2 MB). Leer = Netzwerk-Icon."
        },
        "header_bg_color": {
          "label": "Header-Hintergrund",
          "type": "color",
          "default": "#0c1526",
          "description": "Hintergrundfarbe der Navigationsleiste (Deep Navy)"
        },
        "header_text_color": {
          "label": "Header-Textfarbe",
          "type": "color",
          "default": "#e2e8f0",
          "description": "Farbe von Navigationslinks und Logo-Text (hell auf dunkel)"
        },
        "header_accent_color": {
          "label": "Header-Akzentfarbe",
          "type": "color",
          "default": "#c8952e",
          "description": "Akzentfarbe im Header – aktive Links, Badges, Highlights"
        },
        "header_height": {
          "label": "Header-Höhe (px)",
          "type": "number",
          "default": 72,
          "min": 48,
          "max": 120,
          "description": "Höhe der Navigationsleiste"
        },
        "logo_max_height": {
          "label": "Logo-Maximalhöhe (px)",
          "type": "number",
          "default": 48,
          "min": 24,
          "max": 100,
          "description": "Maximale Höhe des Site-Logos"
        },
        "show_header_shadow": {
          "label": "Header-Schatten anzeigen",
          "type": "checkbox",
          "default": true,
          "description": "Subtiler Schatten unterhalb der Navigationsleiste"
        },
        "show_search_btn": {
          "label": "Such-Button anzeigen",
          "type": "checkbox",
          "default": true,
          "description": "Zeigt den Such-Button im Header an"
        },
        "show_login_btn": {
          "label": "Anmelden-Button anzeigen",
          "type": "checkbox",
          "default": true,
          "description": "Zeigt den Login-Button für nicht angemeldete Besucher"
        },
        "show_register_btn": {
          "label": "Registrieren-Button anzeigen",
          "type": "checkbox",
          "default": true,
          "description": "Zeigt den Registrieren-Button für nicht angemeldete Besucher"
        }
      }
    },

    "footer": {
      "label": "Footer",
      "description": "Hintergrund- und Textfarben, Inhalte und Social-Media-Links im Footer.",
      "settings": {
        "footer_bg_color": {
          "label": "Footer-Hintergrund",
          "type": "color",
          "default": "#0c1526",
          "description": "Hintergrundfarbe des Footers (Deep Navy)"
        },
        "footer_text_color": {
          "label": "Footer-Textfarbe",
          "type": "color",
          "default": "#94a3b8",
          "description": "Textfarbe im Footer-Bereich"
        },
        "footer_link_color": {
          "label": "Footer-Linkfarbe",
          "type": "color",
          "default": "#e2e8f0",
          "description": "Farbe der Links im Footer"
        },
        "footer_text": {
          "label": "Footer-Beschreibungstext",
          "type": "textarea",
          "default": "Die IT-Networking-Plattform für Experten, Unternehmen und Events. Vernetze dich mit der IT-Community.",
          "description": "Text im ersten Widget-Bereich (z.B. Firmenbeschreibung)"
        },
        "show_network_widgets": {
          "label": "Netzwerk-Widgets anzeigen",
          "type": "checkbox",
          "default": true,
          "description": "Zeigt den oberen Footer-Bereich mit Experten/Unternehmen-Links"
        },
        "copyright_text": {
          "label": "Copyright-Text",
          "type": "text",
          "default": "© {year} {site_title}. Alle Rechte vorbehalten.",
          "description": "Platzhalter: {year}, {site_title}. Entfernen nur mit gültiger Lizenz (PhinIT.DE)."
        },
        "social_twitter": {
          "label": "Twitter / X URL",
          "type": "text",
          "default": "",
          "description": "Vollständige URL zum Twitter/X-Profil (leer = ausgeblendet)"
        },
        "social_instagram": {
          "label": "Instagram URL",
          "type": "text",
          "default": "",
          "description": "Vollständige URL zum Instagram-Profil (leer = ausgeblendet)"
        },
        "social_linkedin": {
          "label": "LinkedIn URL",
          "type": "text",
          "default": "",
          "description": "Vollständige URL zum LinkedIn-Profil (leer = ausgeblendet)"
        },
        "social_youtube": {
          "label": "YouTube URL",
          "type": "text",
          "default": "",
          "description": "Vollständige URL zum YouTube-Kanal (leer = ausgeblendet)"
        }
      }
    },

    "buttons": {
      "label": "Buttons",
      "description": "Eckenradius, Padding, Schriftgewicht und Textstil aller Buttons.",
      "settings": {
        "button_border_radius": {
          "label": "Button-Eckenradius (px)",
          "type": "number",
          "default": 6,
          "min": 0,
          "max": 50,
          "description": "Eckenrundung aller regulären Buttons"
        },
        "button_padding_x": {
          "label": "Button-Padding horizontal (rem)",
          "type": "number",
          "default": 1.5,
          "min": 0.5,
          "max": 4,
          "step": 0.25,
          "description": "Horizontaler Innenabstand der Buttons"
        },
        "button_padding_y": {
          "label": "Button-Padding vertikal (rem)",
          "type": "number",
          "default": 0.625,
          "min": 0.25,
          "max": 2,
          "step": 0.125,
          "description": "Vertikaler Innenabstand der Buttons"
        },
        "button_font_weight": {
          "label": "Button-Schriftgewicht",
          "type": "select",
          "options": {
            "400": "Regular (400)",
            "500": "Medium (500)",
            "600": "Semi-Bold (600)",
            "700": "Bold (700)"
          },
          "default": "600",
          "description": "Schriftgewicht aller Buttons"
        },
        "button_transform": {
          "label": "Button-Textumwandlung",
          "type": "select",
          "options": {
            "none": "Normal",
            "uppercase": "GROSSBUCHSTABEN",
            "capitalize": "Erster Buchstabe groß"
          },
          "default": "none",
          "description": "Textformatierung für Button-Beschriftungen"
        }
      }
    },

    "homepage": {
      "label": "Startseite",
      "description": "Sektionen, Inhalte und Layout der Homepage. Jede Sektion bietet Hooks für Plugin-Injektionen.",
      "settings": {
        "show_hero": {
          "label": "Hero-Sektion anzeigen",
          "type": "checkbox",
          "default": true,
          "description": "Zeigt die große Hero-Sektion mit Suchleiste und Statistiken"
        },
        "hero_title": {
          "label": "Hero-Überschrift",
          "type": "text",
          "default": "Führendes Verzeichnis für IT-Experten & Unternehmen",
          "description": "Hauptüberschrift in der Hero-Sektion. Kann per Landing-Page oder Plugin-Filter überschrieben werden."
        },
        "hero_subtitle": {
          "label": "Hero-Untertitel",
          "type": "text",
          "default": "",
          "description": "Optionaler Untertitel unter der Überschrift (leer = ausgeblendet)"
        },
        "show_hero_search": {
          "label": "Suchformular anzeigen",
          "type": "checkbox",
          "default": true,
          "description": "Zeigt die erweiterte Suche in der Hero-Sektion"
        },
        "show_stats_bar": {
          "label": "Statistik-Leiste anzeigen",
          "type": "checkbox",
          "default": true,
          "description": "Zeigt Experten/Firmen/Events/Speaker-Zähler. Plugins können eigene Stats per Filter 'home_stats' hinzufügen."
        },
        "show_experts_section": {
          "label": "Experten-Sektion anzeigen",
          "type": "checkbox",
          "default": true,
          "description": "Zeigt die neuesten Experten-Profile. Benötigt cms-experts Plugin."
        },
        "experts_section_title": {
          "label": "Experten-Überschrift",
          "type": "text",
          "default": "Aktuelle Experten",
          "description": "Titel über der Experten-Sektion"
        },
        "experts_limit": {
          "label": "Anzahl Experten",
          "type": "number",
          "default": 3,
          "min": 1,
          "max": 12,
          "description": "Maximale Anzahl angezeigter Experten-Cards"
        },
        "show_events_section": {
          "label": "Events-Sektion anzeigen",
          "type": "checkbox",
          "default": true,
          "description": "Zeigt kommende Events und Konferenzen. Benötigt cms-events Plugin."
        },
        "events_section_title": {
          "label": "Events-Überschrift",
          "type": "text",
          "default": "Kommende Events & Konferenzen",
          "description": "Titel über der Events-Sektion"
        },
        "events_limit": {
          "label": "Anzahl Events",
          "type": "number",
          "default": 4,
          "min": 1,
          "max": 12,
          "description": "Maximale Anzahl angezeigter Events"
        },
        "show_companies_section": {
          "label": "Firmen-Sektion anzeigen",
          "type": "checkbox",
          "default": true,
          "description": "Zeigt die prominentesten Firmenprofile. Benötigt cms-companies Plugin."
        },
        "companies_section_title": {
          "label": "Firmen-Überschrift",
          "type": "text",
          "default": "Top Firmen im Fokus",
          "description": "Titel über der Firmen-Sektion"
        },
        "companies_limit": {
          "label": "Anzahl Firmen",
          "type": "number",
          "default": 4,
          "min": 1,
          "max": 12,
          "description": "Maximale Anzahl angezeigter Firmen-Cards"
        },
        "show_sidebar": {
          "label": "Sidebar anzeigen",
          "type": "checkbox",
          "default": true,
          "description": "Zeigt die rechte Sidebar. Plugin-Widgets registrieren sich über Hook 'home_sidebar_widget'."
        },
        "homepage_layout": {
          "label": "Seitenlayout",
          "type": "select",
          "options": {
            "sidebar-right": "Sidebar rechts (Standard)",
            "sidebar-left": "Sidebar links",
            "full-width": "Volle Breite (ohne Sidebar)"
          },
          "default": "sidebar-right",
          "description": "Layout der Startseite – Volle Breite deaktiviert die Sidebar"
        },
        "show_events_strip": {
          "label": "Events-Fussleiste anzeigen",
          "type": "checkbox",
          "default": true,
          "description": "Horizontale Events-Vorschau am Ende der Seite"
        }
      }
    },

    "effects": {
      "label": "Effekte & Animationen",
      "description": "Visuelle Effekte wie die Netzwerk-Animation im Header.",
      "settings": {
        "show_network_animation": {
          "label": "Netzwerk-Animation im Header",
          "type": "checkbox",
          "default": true,
          "description": "Zeigt eine dezente Partikel-/Netzwerk-Animation im Header-Hintergrund"
        },
        "animation_speed": {
          "label": "Animations-Geschwindigkeit",
          "type": "select",
          "options": {
            "slow": "Langsam (entspannt)",
            "normal": "Normal",
            "fast": "Schnell (dynamisch)"
          },
          "default": "slow",
          "description": "Bewegungsgeschwindigkeit der Netzwerk-Partikel"
        },
        "animation_opacity": {
          "label": "Animations-Deckkraft (%)",
          "type": "number",
          "default": 15,
          "min": 5,
          "max": 50,
          "step": 5,
          "description": "Sichtbarkeit der Animation (niedrig = dezenter)"
        },
        "animation_node_count": {
          "label": "Anzahl Netzwerk-Knoten",
          "type": "number",
          "default": 25,
          "min": 8,
          "max": 60,
          "description": "Partikelanzahl der Netzwerk-Animation"
        }
      }
    },

    "advanced": {
      "label": "Erweitert",
      "description": "Custom Code, Tracking und erweiterte Einstellungen.",
      "settings": {
        "custom_css": {
          "label": "Eigenes CSS",
          "type": "textarea",
          "default": "",
          "description": "Zusätzliches CSS am Ende aller Theme-Styles. Überschreibt beliebige Stile."
        },
        "custom_head_code": {
          "label": "Custom Head Code (Tracking, Meta)",
          "type": "textarea",
          "default": "",
          "description": "Wird im <head> ausgegeben. Nur vertrauenswürdigen Code einfügen!"
        },
        "custom_footer_code": {
          "label": "Custom Footer Code (Analytics, Widgets)",
          "type": "textarea",
          "default": "",
          "description": "Wird vor </body> ausgegeben."
        }
      }
    }

  }
}
