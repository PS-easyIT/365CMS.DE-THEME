{
  "name": "CMS Phinit",
  "slug": "cms-phinit",
  "version": "1.4.1",
  "author": "phinIT – Andreas Hepp",
  "author_uri": "https://phinit.de",
  "description": "Professionelles IT-Blog-Theme für 365CMS. Dunkles Navy-Design mit Gold-Akzenten, Sticky-Header, Dark-Mode, TOC-Sidebar und responsivem Layout.",
  "requires_cms": "2.5.0",
  "tags": ["blog", "it", "dark-mode", "responsive", "sidebar"],
  "templates": {
    "home":        "index.php",
    "page":        "page.php",
    "post":        "post.php",
    "blog-single": "blog-single.php",
    "blog":        "blog.php",
    "login":       "login.php",
    "register":    "register.php",
    "404":         "404.php",
    "error":       "error.php",
    "search":      "search.php"
  },
  "post_templates": [
    {
      "id":          "default",
      "label":       "Standard (mit TOC-Sidebar)",
      "description": "2-Spalten-Layout: Artikel + sticky Sidebar mit automatisch generiertem Inhaltsverzeichnis, Kategorien-Widget und Social-Icons.",
      "file":        "post.php",
      "features":    ["sidebar", "toc", "comments", "prev-next", "share-buttons"]
    },
    {
      "id":          "wide",
      "label":       "Vollbreite (ohne Sidebar)",
      "description": "Einzelne zentrierte Spalte (max. 860 px) mit aufklappbarem Inline-TOC. Ideal für lange Tutorials und Guides.",
      "file":        "post-wide.php",
      "features":    ["toc-inline", "comments", "prev-next", "share-buttons"]
    },
    {
      "id":          "tech",
      "label":       "Tech-Artikel (mit Tech-Karte)",
      "description": "Wie Standard, jedoch mit einer Tech-Karte vor dem Artikel-Body: Betriebssystem, Version, Voraussetzungen und Schwierigkeit. Metadaten aus post[meta].",
      "file":        "post-tech.php",
      "features":    ["sidebar", "toc", "tech-card", "comments", "prev-next", "share-buttons"],
      "meta_fields": {
        "os":            { "label": "Betriebssystem",    "type": "text",    "placeholder": "Windows Server 2022" },
        "version":       { "label": "Version",           "type": "text",    "placeholder": "PowerShell 7.4" },
        "last_tested":   { "label": "Zuletzt getestet",  "type": "date"  },
        "difficulty":    { "label": "Schwierigkeit",     "type": "select",  "options": ["beginner","intermediate","advanced","expert"] },
        "prerequisites": { "label": "Voraussetzungen",   "type": "array",   "placeholder": "Admin-Rechte" },
        "time_needed":   { "label": "Benötigte Zeit",    "type": "text",    "placeholder": "30 Minuten" }
      }
    }
  ],
  "page_templates": [
    {
      "id":          "default",
      "label":       "Standard (mit Sidebar)",
      "description": "2-Spalten-Layout: Seiteninhalt + Sidebar mit Social-Icons und Navigations-Widget.",
      "file":        "page.php",
      "features":    ["sidebar", "breadcrumbs"]
    },
    {
      "id":          "wide",
      "label":       "Vollbreite (ohne Sidebar)",
      "description": "Volle Container-Breite ohne max-width-Beschränkung. Ideal für Landing-Seiten, Portfolio und Content-Showcases.",
      "file":        "page-wide.php",
      "features":    ["breadcrumbs", "full-width"]
    },
    {
      "id":          "landing",
      "label":       "Landing Page (Hero + Cards)",
      "description": "Vollbreite-Landing-Page mit Gradient-Hero, Feature-Cards-Grid und optionalem CTA-Banner. Konfiguration via page[meta].",
      "file":        "page-landing.php",
      "features":    ["hero", "feature-cards", "cta-banner"],
      "meta_fields": {
        "hero_subtitle":    { "label": "Hero-Untertitel",            "type": "textarea" },
        "hero_cta_label":   { "label": "CTA-Button-Text (primär)",   "type": "text" },
        "hero_cta_url":     { "label": "CTA-Button-URL (primär)",    "type": "url" },
        "hero_cta2_label":  { "label": "CTA-Button-Text (sekundär)", "type": "text" },
        "hero_cta2_url":    { "label": "CTA-Button-URL (sekundär)",  "type": "url" },
        "features":         { "label": "Feature-Cards",              "type": "array-of-objects", "fields": ["icon","title","text","url"] },
        "cta_title":        { "label": "CTA-Banner Titel",           "type": "text" },
        "cta_text":         { "label": "CTA-Banner Text",            "type": "textarea" },
        "cta_button_label": { "label": "CTA-Banner Button-Text",     "type": "text" },
        "cta_button_url":   { "label": "CTA-Banner Button-URL",      "type": "url" }
      }
    }
  ],
  "partials": {
    "header": "header.php",
    "footer": "footer.php"
  },
  "menus": {
    "primary":       "Hauptnavigation",
    "quicklinks":    "Quicklinks (Sub-Navigation)",
    "footer-topics": "Footer – Themen",
    "footer-pages":  "Footer – Seiten",
    "footer":        "Footer – Rechtliches"
  },
  "supports": [
    "dark-mode",
    "sticky-header",
    "toc-sidebar",
    "scroll-progress",
    "back-to-top",
    "consent-banner",
    "reading-time",
    "schema-org",
    "member-area"
  ],
  "member_pages": {
    "dashboard":  "member/dashboard.php",
    "profile":    "member/profile.php",
    "favorites":  "member/favorites.php",
    "comments":   "member/comments.php",
    "newsletter": "member/newsletter.php",
    "feeds":      "member/feeds.php",
    "forum":      "member/forum.php",
    "security":   "member/security.php"
  },
