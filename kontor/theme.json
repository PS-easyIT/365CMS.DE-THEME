                "faq_4_q": { "label": "Frage 4", "type": "text", "default": "Unterstützen Sie bei Förderanträgen?" },
                "faq_4_a": { "label": "Antwort 4", "type": "textarea", "default": "Ja, von der Auswahl des passenden Programms bis zum Verwendungsnachweis." },
                "faq_5_q": { "label": "Frage 5", "type": "text", "default": "" },
