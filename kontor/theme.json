                "service_4_icon": { "label": "Leistung 4: Symbol", "type": "select", "options": { "compass": "Kompass", "chart": "Diagramm", "shield": "Schild", "cloud": "Cloud", "people": "Team", "gear": "Zahnrad", "handshake": "Handschlag", "document": "Dokument", "leaf": "Blatt", "bolt": "Blitz", "euro": "Euro", "target": "Zielscheibe" }, "default": "shield" },
