                "service_5_icon": { "label": "Leistung 5: Symbol", "type": "select", "options": { "compass": "Kompass", "chart": "Diagramm", "shield": "Schild", "cloud": "Cloud", "people": "Team", "gear": "Zahnrad", "handshake": "Handschlag", "document": "Dokument", "leaf": "Blatt", "bolt": "Blitz", "euro": "Euro", "target": "Zielscheibe" }, "default": "people" },
                "service_5_url": { "label": "Leistung 5: Link (optional)", "type": "text", "default": "" },
                "service_6_title": { "label": "Leistung 6: Titel", "type": "text", "default": "Nachhaltigkeit" },
                "service_6_text": { "label": "Leistung 6: Text", "type": "textarea", "default": "Energie sparen, Berichte erstellen, Lieferketten verbessern – pragmatisch und messbar." },
                "service_6_icon": { "label": "Leistung 6: Symbol", "type": "select", "options": { "compass": "Kompass", "chart": "Diagramm", "shield": "Schild", "cloud": "Cloud", "people": "Team", "gear": "Zahnrad", "handshake": "Handschlag", "document": "Dokument", "leaf": "Blatt", "bolt": "Blitz", "euro": "Euro", "target": "Zielscheibe" }, "default": "leaf" },
                "service_6_url": { "label": "Leistung 6: Link (optional)", "type": "text", "default": "" }
            }
        },
        "kt_about": {
