{
    "name": "Kontor",
    "slug": "kontor",
    "version": "1.0.0",
    "requires_cms": "3.4.00",
    "requires_php": "8.4",
    "author": "PHINIT.DE / Andreas Hepp",
    "description": "Business-Theme für Mittelstand, Kanzleien, Beratungen und Dienstleister – Tannengrün mit Mint-Akzent, Manrope-Typografie, vollständig pflegbare Startseite (Hero, Leistungen, Über uns, Kennzahlen, Ablauf, Referenz, FAQ, Aktuelles, Kontakt-CTA) und seriöse Unterseiten mit Kontaktkarte.",
    "textdomain": "kontor",
    "template": "kontor",
    "tags": ["business", "unternehmen", "mittelstand", "beratung", "kanzlei", "dienstleister", "corporate", "responsive"],
    "supports": ["custom-logo", "sticky-header", "custom-css", "faq", "testimonial", "contact-cta"],
    "templates": {
        "home": "home.php",
        "blog": "blog.php",
        "category": "category.php",
        "tag": "tag.php",
        "author": "author.php",
        "blog-single": "blog-single.php",
        "page": "page.php",
        "search": "search.php",
        "404": "404.php",
        "error": "error.php",
        "index": "index.php"
    },
    "menus": {
        "primary": "Hauptnavigation (Header)",
        "footer-nav": "Footer: Unternehmen",
        "footer-services": "Footer: Leistungen",
        "footer-legal": "Rechtliche Links (Footer)"
    },
    "settings": {
        "company_name": "Kontor Beratung GmbH"
    },
    "customization": {
        "colors": {
            "label": "Farben",
            "description": "Tannengrün als Markenanker, Mint als Akzent für Buttons und Hervorhebungen, Sand für ruhige Flächen.",
            "settings": {
                "ink_color": { "label": "Anker (dunkles Tannengrün)", "type": "color", "default": "#0e2f28", "description": "Hero, CTA-Band, Footer und Überschriften." },
                "primary_color": { "label": "Primärfarbe (Grün)", "type": "color", "default": "#156b52", "description": "Links, Buttons auf hellen Flächen, Icons." },
                "primary_hover": { "label": "Primärfarbe Hover", "type": "color", "default": "#0f5541" },
                "accent_color": { "label": "Akzent (Mint)", "type": "color", "default": "#62d6a4", "description": "Buttons und Hervorhebungen auf dunklen Flächen." },
                "text_color": { "label": "Text", "type": "color", "default": "#1c2b27" },
                "muted_color": { "label": "Gedämpfter Text", "type": "color", "default": "#5a6b65" },
                "paper_color": { "label": "Hintergrund", "type": "color", "default": "#ffffff" },
                "sand_color": { "label": "Sekundärfläche (Sand)", "type": "color", "default": "#f5f2eb" },
                "border_color": { "label": "Linien & Rahmen", "type": "color", "default": "#e3e6e1" }
            }
        },
        "typography": {
            "label": "Typografie",
            "settings": {
                "font_heading": {
                    "label": "Schrift für Überschriften",
                    "type": "select",
                    "options": {
                        "manrope": "Manrope (Standard)",
                        "plus-jakarta-sans": "Plus Jakarta Sans",
                        "sora": "Sora",
                        "montserrat": "Montserrat",
                        "source-serif": "Source Serif 4 (klassisch, z. B. Kanzleien)",
                        "system": "System-Sans (ohne Webfonts)"
                    },
                    "default": "manrope"
                },
                "font_body": {
                    "label": "Schrift für Fließtext",
                    "type": "select",
                    "options": {
                        "manrope": "Manrope (Standard)",
                        "inter": "Inter",
                        "source-sans": "Source Sans 3",
                        "system": "System-Sans (ohne Webfonts)"
                    },
                    "default": "manrope"
                },
                "font_size_base": { "label": "Basis-Schriftgröße (px)", "type": "number", "default": 17, "min": 15, "max": 20 }
            }
        },
        "layout": {
            "label": "Layout",
            "settings": {
                "container_width": { "label": "Maximale Seitenbreite (px)", "type": "number", "default": 1200, "min": 1040, "max": 1440 },
                "border_radius": { "label": "Eckenradius (px)", "type": "number", "default": 14, "min": 0, "max": 28 },
                "page_sidebar": { "label": "Kontaktkarte neben Seiten und Beiträgen", "type": "checkbox", "default": true }
            }
        },
        "header": {
            "label": "Header",
            "settings": {
                "logo_url": { "label": "Logo (optional)", "type": "image", "default": "", "description": "Ohne Logo erscheint ein Monogramm mit dem Seitentitel." },
                "enable_sticky_header": { "label": "Header beim Scrollen fixieren", "type": "checkbox", "default": true },
                "show_contact_bar": { "label": "Kontaktleiste über dem Header", "type": "checkbox", "default": true },
                "contact_bar_text": { "label": "Text in der Kontaktleiste", "type": "text", "default": "Mo–Fr 8–18 Uhr persönlich erreichbar" },
