        "kt_hero": {
            "label": "Startseite: Hero",
            "description": "Wörter in *Sternchen* werden in der Überschrift farbig hervorgehoben.",
            "settings": {
                "eyebrow": { "label": "Kicker über der Überschrift", "type": "text", "default": "Beratung für den Mittelstand" },
                "headline": { "label": "Überschrift", "type": "text", "default": "Wir machen Ihr Unternehmen *zukunftssicher*." },
                "text": { "label": "Einleitung", "type": "textarea", "default": "Strategie, Digitalisierung und Finanzierung aus einer Hand – mit festen Ansprechpartnern, klaren Festpreisen und Ergebnissen, die im Alltag funktionieren." },
                "cta_primary_label": { "label": "Button 1: Text", "type": "text", "default": "Kostenloses Erstgespräch" },
                "cta_primary_url": { "label": "Button 1: Link", "type": "text", "default": "/kontakt" },
                "cta_secondary_label": { "label": "Button 2: Text", "type": "text", "default": "Unsere Leistungen" },
                "cta_secondary_url": { "label": "Button 2: Link", "type": "text", "default": "#leistungen" },
                "image_url": { "label": "Hero-Bild (optional)", "type": "image", "default": "" },
                "trust_points": { "label": "Vertrauenspunkte (eine Zeile je Punkt)", "type": "textarea", "default": "Über 25 Jahre Erfahrung\nFeste Ansprechpartner\nTransparente Festpreise" },
                "badge_value": { "label": "Plakette: Wert", "type": "text", "default": "4,9 / 5" },
                "badge_label": { "label": "Plakette: Beschriftung", "type": "text", "default": "Kundenzufriedenheit aus 180 Bewertungen" }
            }
        },
        "kt_trust": {
            "label": "Startseite: Kundenleiste",
            "settings": {
                "show_trust": { "label": "Kundenleiste anzeigen", "type": "checkbox", "default": true },
