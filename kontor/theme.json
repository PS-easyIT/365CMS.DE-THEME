                "about_text": { "label": "Text", "type": "textarea", "default": "Seit 1998 beraten wir Familienunternehmen, Handwerksbetriebe und Mittelständler zwischen Hamburg und Hannover. Wir hören zu, rechnen nach und bleiben, bis die Lösung trägt." },
                "about_points": { "label": "Stichpunkte (eine Zeile je Punkt)", "type": "textarea", "default": "Zertifiziert nach ISO 9001\nMitglied im Bundesverband mittelständische Wirtschaft\nEigene Fachleute statt Subunternehmer" },
